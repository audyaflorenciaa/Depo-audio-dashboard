# ==============================================================================
# Depo Audio OS - Backend Environment Variables
# ==============================================================================
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must NEVER be committed.

# Supabase project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase service-role key (full-access, server-side only - keep secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase JWT secret (used for verifying auth tokens - auth middleware not yet implemented)
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Comma-separated list of allowed CORS origins
# Default for local dev is the Vite dev server
CORS_ALLOWED_ORIGINS=http://localhost:5173
